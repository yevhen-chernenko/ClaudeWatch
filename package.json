{
  "name": "claudewatch",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:extension && npm run build:hooks && npm run copy:assets && npm run format:dist",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:hooks": "tsc -p tsconfig.hooks.json",
    "format:dist": "eslint --fix dist",
    "copy:assets": "node scripts/copy-assets.mjs",
    "pack": "npm run build && node scripts/pack-extension.mjs",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.hooks.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@girs/gjs": "4.1.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/pango-1.0": "4.1.0",
    "@girs/soup-3.0": "4.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.13.0",
    "eslint": "^10.11.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@girs/gio-2.0": "4.1.0",
    "@girs/glib-2.0": "4.1.0",
    "@girs/gobject-2.0": "4.1.0"
  }
}
